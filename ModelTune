refined<-final_data[,c('OCC','BORO','STORIES','ELEVATOR','UNITS','UNIT_FLOOR','UNIT_ONEPLUSFLIGHT','ELEV_NO_STEPS','UNIT_NO_STEPS','YEARBUILT','BEDROOMS','ROOMS','FULLBATH_NUM','HALFBATH_NUM','MonthlyCost')]
no_na<-drop_na(refined)
maxdepth_values <- 5:10
minsplit_values <- seq(8, 50, by = 1)

best_accuracy <- 0
best_model <- NULL
best_params <- list()

for (depth in maxdepth_values) {
  for (split in minsplit_values) {
    tree_model <- rpart(
      as.factor(OCC) ~ BORO+STORIES+ELEVATOR+UNITS+UNIT_FLOOR+UNIT_ONEPLUSFLIGHT+ELEV_NO_STEPS+UNIT_NO_STEPS+YEARBUILT+BEDROOMS+ROOMS+FULLBATH_NUM+HALFBATH_NUM+MonthlyCost, 
      data = no_na, 
      method = "class",
      control = rpart.control(maxdepth = depth, minsplit = split, cp = 0.01)
    )
    
    if (!is.null(tree_model$cptable)) {
      optimal_cp <- tree_model$cptable[which.min(tree_model$cptable[,"xerror"]), "CP"]
      cv_tree <- prune(tree_model, cp = optimal_cp)
      
      yhat <- predict(cv_tree, newdata = no_na, type = "class")
      
      conf_matrix <- table(Predicted = yhat, Actual = no_na$OCC)
      accuracy <- sum(diag(conf_matrix)) / sum(conf_matrix)
      
      if (accuracy > best_accuracy) {
        best_accuracy <- accuracy
        best_model <- cv_tree
        best_params <- list(maxdepth = depth, minsplit = split)
      }
    }
  }
}

